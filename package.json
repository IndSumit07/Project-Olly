{
  "name": "my-olly",
  "version": "2.1.0",
  "type": "module",
  "description": "Olly – Autonomous AI coding agent. Multi-step reasoning, file editing, shell execution, memory, skills & 15+ AI providers including TokenLB.",
  "keywords": [
    "ai", "agent", "cli", "coding-assistant", "autonomous",
    "openai", "anthropic", "gemini", "groq", "ollama",
    "claude", "gpt", "ai-agent", "tokenlb", "openrouter",
    "terminal", "developer-tools", "code-generation"
  ],
  "homepage": "https://github.com/IndSumit07/Project-Olly#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/IndSumit07/Project-Olly.git"
  },
  "bugs": {
    "url": "https://github.com/IndSumit07/Project-Olly/issues"
  },
  "license": "MIT",
  "author": "IndSumit07",
  "bin": {
    "olly": "./bin/olly.js"
  },
  "files": [
    "bin/",
    "ai/",
    "modes/",
    "tui/",
    "tools/",
    "memory/",
    "skills/",
    "scripts/",
    "index.js",
    "README.md",
    "context.md"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm && bun build ./bin/olly.ts --outdir ./bin --outfile olly.js --target node --format esm",
    "prepublishOnly": "bun run build",
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "bun run index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.81",
    "@ai-sdk/azure": "3.0.68",
    "@ai-sdk/cerebras": "2.0.54",
    "@ai-sdk/cohere": "3.0.36",
    "@ai-sdk/deepseek": "2.0.35",
    "@ai-sdk/google": "3.0.80",
    "@ai-sdk/groq": "3.0.39",
    "@ai-sdk/mistral": "3.0.37",
    "@ai-sdk/openai": "3.0.67",
    "@ai-sdk/perplexity": "3.0.33",
    "@ai-sdk/xai": "3.0.93",
    "@clack/core": "^1.3.1",
    "@clack/prompts": "^1.4.0",
    "@mendable/firecrawl-js": "^4.25.1",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.9.1",
    "ai": "6.0.193",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "figlet": "^1.11.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ollama-ai-provider": "1.2.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  }
}
